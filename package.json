{
  "name": "tallersmart-workspace",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm run db:up && pnpm --parallel --filter @tallersmart/api --filter web dev",
    "dev:web": "pnpm -F web dev",
    "api:dev": "pnpm run db:up && pnpm --filter @tallersmart/api dev",
    "web:dev": "pnpm --filter web dev",
    "db:up": "docker compose up -d --wait db",
    "build": "pnpm -F web build",
    "start": "pnpm -F web start",
    "lint": "pnpm -F web lint"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "typescript": "^5.9.3"
  }
}
